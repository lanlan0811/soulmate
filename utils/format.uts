/** 时间 / 文本 / 颜色等纯函数工具。 */

export function pad2(value: number): string {
	return value < 10 ? `0${value}` : `${value}`
}

export function formatClock(ts: number): string {
	const d = new Date(ts)
	return `${pad2(d.getHours())}:${pad2(d.getMinutes())}`
}

export function isSameDay(a: number, b: number): boolean {
	const da = new Date(a)
	const db = new Date(b)
	return da.getFullYear() == db.getFullYear() && da.getMonth() == db.getMonth() && da.getDate() == db.getDate()
}

/** 会话列表用：今天 HH:mm / 昨天 / M/D */
export function formatListTime(ts: number): string {
	const now = Date.now()
	if (isSameDay(ts, now)) return formatClock(ts)
	const yesterday = now - 86400000
	if (isSameDay(ts, yesterday)) return '昨天'
	const d = new Date(ts)
	return `${d.getMonth() + 1}/${d.getDate()}`
}

/** 消息气泡与详情用：今天 HH:mm / 昨天 HH:mm / M月D日 HH:mm */
export function formatFullTime(ts: number): string {
	const now = Date.now()
	if (isSameDay(ts, now)) return formatClock(ts)
	const yesterday = now - 86400000
	if (isSameDay(ts, yesterday)) return `昨天 ${formatClock(ts)}`
	const d = new Date(ts)
	return `${d.getMonth() + 1}月${d.getDate()}日 ${formatClock(ts)}`
}

export function formatDate(ts: number): string {
	const d = new Date(ts)
	return `${d.getFullYear()}/${pad2(d.getMonth() + 1)}/${pad2(d.getDate())}`
}

export function firstChar(name: string): string {
	if (name.length == 0) return '心'
	return name.substring(0, 1)
}

export function truncate(text: string, max: number): string {
	if (text.length <= max) return text
	return text.substring(0, max) + '…'
}

/** 头像底色：tone 0-5 对应 6 组 token 色板 */
export function toneBgClass(tone: number): string {
	if (tone == 1) return 'sm-tint-1'
	if (tone == 2) return 'sm-tint-2'
	if (tone == 3) return 'sm-tint-3'
	if (tone == 4) return 'sm-tint-4'
	if (tone == 5) return 'sm-tint-5'
	return 'sm-tint-0'
}

export function toneFgClass(tone: number): string {
	if (tone == 1) return 'sm-tint-fg-1'
	if (tone == 2) return 'sm-tint-fg-2'
	if (tone == 3) return 'sm-tint-fg-3'
	if (tone == 4) return 'sm-tint-fg-4'
	if (tone == 5) return 'sm-tint-fg-5'
	return 'sm-tint-fg-0'
}

/** 上下文占用率：按字符数粗略估算，空会话为 0。 */
export function contextPercent(charCount: number, limit: number): number {
	if (charCount <= 0) return 0
	const p = Math.round((charCount / limit) * 100)
	if (p > 99) return 99
	return p
}
