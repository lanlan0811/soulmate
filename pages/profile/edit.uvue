<template>
	<view class="sm-page">
		<sm-nav-bar title="我的资料" @back="goBack"></sm-nav-bar>

		<scroll-view class="body" :scroll-y="true">
			<view class="body__inner">
				<view class="preview">
					<sm-avatar :name="avatarName" :tone="tone" size="xl"></sm-avatar>
					<text class="preview__name">{{ nickname.length == 0 ? '还没有称呼' : nickname }}</text>
				</view>

				<view class="tones">
					<text class="tones__label">头像底色</text>
					<view class="tones__list">
						<view v-for="index in toneIndexes" :key="index" class="tones__dot" :class="[toneClass(index), index == tone ? 'tones__dot--active' : '']" @click="tone = index"></view>
					</view>
				</view>

				<view class="field">
					<sm-field v-model="nickname" label="Ta 怎么称呼你" placeholder="留空就由 Ta 自己决定" :maxlength="20" :countable="true"></sm-field>
				</view>

				<view class="field">
					<sm-field v-model="bio" label="自我介绍" placeholder="你是怎样的人、在意什么" :maxlength="120" :multiline="true" :countable="true"></sm-field>
				</view>

				<view class="note">
					<sm-icon name="lock" variant="brand" size="sm"></sm-icon>
					<text class="note__text">这部分资料只存在本机，不会上传。</text>
				</view>

				<view class="save">
					<sm-button label="保存" block size="lg" @tap="save"></sm-button>
				</view>
			</view>
		</scroll-view>

		<view class="sm-safe-bottom"></view>
	</view>
</template>

<script setup lang="ts">
	import { computed, ref } from 'vue'
	import { state, saveProfile } from '../../store/app.uts'
	import { toneBgClass } from '../../utils/format.uts'

	const nickname = ref('')
	const bio = ref('')
	const tone = ref(0)
	const toneIndexes = [0, 1, 2, 3, 4, 5]

	onLoad(() => {
		nickname.value = state.profile.nickname
		bio.value = state.profile.bio
		tone.value = state.profile.tone
	})

	const avatarName = computed((): string => nickname.value.length == 0 ? '我' : nickname.value)

	const toneClass = (index: number): string => toneBgClass(index)

	const save = (): void => {
		saveProfile(nickname.value.trim(), bio.value.trim(), tone.value)
		uni.showToast({ title: '已保存', position: 'bottom' })
		uni.navigateBack()
	}

	const goBack = (): void => {
		uni.navigateBack()
	}
</script>

<style>
	.sm-page {
		flex: 1;
		flex-direction: column;
		background-color: var(--sm-color-bg-canvas);
	}

	.body {
		flex: 1;
	}

	.body__inner {
		flex-direction: column;
		padding-left: var(--sm-size-page-gutter);
		padding-right: var(--sm-size-page-gutter);
		padding-bottom: var(--sm-space-6);
	}

	.preview {
		align-items: center;
		padding-top: var(--sm-space-4);
		padding-bottom: var(--sm-space-4);
	}

	.preview__name {
		margin-top: var(--sm-space-3);
		font-size: var(--sm-fs-xl);
		font-weight: var(--sm-weight-bold);
		color: var(--sm-color-text-primary);
	}

	.tones {
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		background-color: var(--sm-color-bg-surface);
		border-radius: var(--sm-radius-lg);
		padding-left: var(--sm-space-4);
		padding-right: var(--sm-space-4);
		padding-top: var(--sm-space-3);
		padding-bottom: var(--sm-space-3);
		margin-bottom: var(--sm-space-4);
	}

	.tones__label {
		font-size: var(--sm-fs-sm);
		color: var(--sm-color-text-secondary);
	}

	.tones__list {
		flex-direction: row;
		align-items: center;
	}

	.tones__dot {
		width: var(--sm-size-control-sm);
		height: var(--sm-size-control-sm);
		border-radius: var(--sm-radius-full);
		margin-left: var(--sm-space-2);
		border-width: var(--sm-border-thick);
		border-style: solid;
		border-color: transparent;
	}

	.tones__dot--active {
		border-color: var(--sm-color-action-primary);
	}

	.field {
		margin-bottom: var(--sm-space-4);
	}

	.note {
		flex-direction: row;
		align-items: center;
		padding-left: var(--sm-space-3);
		padding-right: var(--sm-space-3);
		padding-top: var(--sm-space-2);
		padding-bottom: var(--sm-space-2);
		border-radius: var(--sm-radius-md);
		background-color: var(--sm-color-brand-100);
	}

	.note__text {
		margin-left: var(--sm-space-1);
		font-size: var(--sm-fs-xs);
		color: var(--sm-color-brand-800);
	}

	.save {
		margin-top: var(--sm-space-6);
	}
</style>
