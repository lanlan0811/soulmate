	}

	.chart {
		flex-direction: row;
		align-items: flex-end;
		height: var(--sm-space-12);
		margin-top: var(--sm-space-4);
	}

	.chart__col {
		flex: 1;
		flex-direction: column;
		align-items: center;
	}

	.chart__bar-wrap {
		height: var(--sm-space-12);
