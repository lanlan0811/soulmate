<template>
	<view class="sm-stat">
		<view v-if="icon.length > 0" class="sm-stat__icon">
			<sm-icon :name="icon" variant="brand" size="sm"></sm-icon>
		</view>
		<text class="sm-stat__value" :class="valueClass">{{ displayValue }}</text>
		<text class="sm-stat__label">{{ label }}</text>
	</view>
</template>

<script setup lang="ts">
	import { computed } from 'vue'

	const props = withDefaults(defineProps<{
		label?: string
		value?: number
		icon?: string
		placeholder?: string
	}>(), {
		label: '',
		value: 0,
		icon: '',
		placeholder: '—'
	})

	const displayValue = computed((): string => {
		if (props.value <= 0) return props.placeholder
		return `${props.value}`
	})

	const valueClass = computed((): string => (props.value <= 0 ? 'sm-stat__value--empty' : ''))
</script>

<style>
	.sm-stat {
		flex: 1;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		background-color: var(--sm-color-bg-surface);
		border-radius: var(--sm-radius-lg);
		padding-top: var(--sm-space-4);
		padding-bottom: var(--sm-space-4);
	}

	.sm-stat__icon {
		width: var(--sm-space-8);
		height: var(--sm-space-8);
		border-radius: var(--sm-radius-full);
		background-color: var(--sm-color-brand-100);
		align-items: center;
		justify-content: center;
		margin-bottom: var(--sm-space-2);
	}

	.sm-stat__value {
		font-size: var(--sm-fs-xl);
		font-weight: var(--sm-weight-bold);
		color: var(--sm-color-text-primary);
		line-height: var(--sm-lh-tight);
	}

	.sm-stat__value--empty {
		color: var(--sm-color-text-muted);
	}

	.sm-stat__label {
		margin-top: var(--sm-space-1);
		font-size: var(--sm-fs-xs);
		color: var(--sm-color-text-muted);
	}
</style>
