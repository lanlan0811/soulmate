<template>
	<view v-if="visible" class="sm-dialog-mask">
		<view class="sm-dialog">
			<text class="sm-dialog__title">{{ title }}</text>
			<text v-if="desc.length > 0" class="sm-dialog__desc">{{ desc }}</text>
			<view class="sm-dialog__actions">
				<view class="sm-dialog__action" @click="onCancel">
					<text class="sm-dialog__cancel">{{ cancelLabel }}</text>
				</view>
				<view class="sm-dialog__action sm-dialog__action--primary" @click="onConfirm">
					<text class="sm-dialog__confirm" :class="danger ? 'sm-dialog__confirm--danger' : ''">{{ confirmLabel }}</text>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="ts">
	const props = withDefaults(defineProps<{
		visible?: boolean
		title?: string
		desc?: string
		confirmLabel?: string
		cancelLabel?: string
		danger?: boolean
	}>(), {
		visible: false,
		title: '',
		desc: '',
		confirmLabel: '确定',
		cancelLabel: '取消',
		danger: false
	})

	const emit = defineEmits(['confirm', 'cancel'])

	const onConfirm = (): void => {
		emit('confirm')
	}

	const onCancel = (): void => {
		emit('cancel')
	}
</script>

<style>
	.sm-dialog-mask {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background-color: var(--sm-color-neutral-950);
		opacity: 0.5;
		z-index: 300;
		align-items: center;
		justify-content: center;
		padding-left: var(--sm-space-6);
		padding-right: var(--sm-space-6);
	}

	.sm-dialog {
		width: 100%;
		border-radius: var(--sm-radius-xl);
		background-color: var(--sm-color-bg-raised);
		padding-left: var(--sm-space-5);
		padding-right: var(--sm-space-5);
		padding-top: var(--sm-space-5);
		padding-bottom: var(--sm-space-4);
		flex-direction: column;
		box-shadow: var(--sm-shadow-lg);
	}

	.sm-dialog__title {
		font-size: var(--sm-fs-lg);
		font-weight: var(--sm-weight-bold);
		color: var(--sm-color-text-primary);
		text-align: center;
	}

	.sm-dialog__desc {
		margin-top: var(--sm-space-2);
		font-size: var(--sm-fs-sm);
		color: var(--sm-color-text-secondary);
		text-align: center;
		line-height: var(--sm-lh-normal);
	}

	.sm-dialog__actions {
		flex-direction: row;
		margin-top: var(--sm-space-5);
	}

	.sm-dialog__action {
		flex: 1;
		height: var(--sm-size-control-lg);
		align-items: center;
		justify-content: center;
		border-radius: var(--sm-radius-full);
		margin-left: var(--sm-space-1);
		margin-right: var(--sm-space-1);
	}

	.sm-dialog__action--primary {
		background-color: var(--sm-color-action-primary);
	}

	.sm-dialog__cancel {
		font-size: var(--sm-fs-md);
		color: var(--sm-color-text-secondary);
	}

	.sm-dialog__confirm {
		font-size: var(--sm-fs-md);
		font-weight: var(--sm-weight-semibold);
		color: var(--sm-color-action-primary-text);
	}

	.sm-dialog__confirm--danger {
		color: var(--sm-color-action-danger-text);
	}
</style>
