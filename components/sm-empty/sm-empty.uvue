<template>
	<view class="sm-empty">
		<view class="sm-empty__icon">
			<sm-icon :name="icon" variant="soft" size="lg"></sm-icon>
		</view>
		<text class="sm-empty__title">{{ title }}</text>
		<text v-if="desc.length > 0" class="sm-empty__desc">{{ desc }}</text>
		<view v-if="action.length > 0" class="sm-empty__action">
			<sm-button :label="action" size="sm" variant="soft" :icon="actionIcon" @tap="onAction"></sm-button>
		</view>
	</view>
</template>

<script setup lang="ts">
	const props = withDefaults(defineProps<{
		icon?: string
		title?: string
		desc?: string
		action?: string
		actionIcon?: string
	}>(), {
		icon: 'sparkles',
		title: '',
		desc: '',
		action: '',
		actionIcon: ''
	})

	const emit = defineEmits(['action'])

	const onAction = (): void => {
		emit('action')
	}
</script>

