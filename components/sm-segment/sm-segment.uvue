<template>
	<view class="sm-segment">
		<view v-for="(item, index) in items" :key="item.value" class="sm-segment__item" :class="index == activeIndex ? 'sm-segment__item--active' : ''" @click="onSelect(index)">
			<text class="sm-segment__label" :class="index == activeIndex ? 'sm-segment__label--active' : ''">{{ item.label }}</text>
		</view>
	</view>
</template>

<script setup lang="ts">
	import { computed } from 'vue'

	type SegmentItem = {
		value: string
		label: string
	}

	const props = withDefaults(defineProps<{
		items?: SegmentItem[]
		modelValue?: string
	}>(), {
		items: () => [] as SegmentItem[],
		modelValue: ''
	})

	const emit = defineEmits(['update:modelValue', 'change'])

	const activeIndex = computed((): number => {
		for (let i = 0; i < props.items.length; i++) {
			if (props.items[i].value == props.modelValue) return i
		}
		return 0
	})

	const onSelect = (index: number): void => {
		emit('update:modelValue', props.items[index].value)
		emit('change', props.items[index].value)
	}
</script>

<style>
	.sm-segment {
		flex-direction: row;
		height: var(--sm-size-control-lg);
		padding-left: var(--sm-space-1);
		padding-right: var(--sm-space-1);
		padding-top: var(--sm-space-1);
		padding-bottom: var(--sm-space-1);
		border-radius: var(--sm-radius-full);
		background-color: var(--sm-color-bg-sunken);
	}

	.sm-segment__item {
		flex: 1;
		align-items: center;
		justify-content: center;
		border-radius: var(--sm-radius-full);
	}

	.sm-segment__item--active {
		background-color: var(--sm-color-bg-surface);
		box-shadow: var(--sm-shadow-sm);
	}

	.sm-segment__label {
		font-size: var(--sm-fs-sm);
		color: var(--sm-color-text-muted);
	}

	.sm-segment__label--active {
		color: var(--sm-color-text-primary);
		font-weight: var(--sm-weight-semibold);
	}
</style>
