<template>
	<view class="sm-tab-bar" :class="dockClass">
		<view class="sm-tab-bar__inner">
			<view v-for="(item, index) in items" :key="item.key" class="sm-tab" :hover-class="'sm-tab--hover'" @click="onSelect(index)">
				<view class="sm-tab__icon-wrap">
					<sm-icon :name="item.icon" :variant="index == current ? 'brand' : 'muted'" size="lg"></sm-icon>
					<view v-if="item.badge && index != current" class="sm-tab__dot"></view>
				</view>
				<text class="sm-tab__label" :class="index == current ? 'sm-tab__label--active' : ''">{{ item.label }}</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="ts">
	import { computed } from 'vue'

	type TabItem = {
		key: string
		label: string
		icon: string
		badge: boolean
	}

	const props = withDefaults(defineProps<{
		current: number
		unread?: number
	}>(), {
		unread: 0
	})

	const emit = defineEmits(['change'])

	const items = computed((): TabItem[] => {
		return [
			{ key: 'messages', label: '消息', icon: 'message-circle', badge: props.unread > 0 },
			{ key: 'personas', label: '人设', icon: 'smile', badge: false },
			{ key: 'profile', label: '我的', icon: 'user', badge: false },
			{ key: 'about', label: '关于', icon: 'info', badge: false }
		] as TabItem[]
	})

	const dockClass = computed((): string => '')

	const onSelect = (index: number): void => {
		emit('change', index)
	}
</script>

<style>
	.sm-tab-bar {
		padding-left: var(--sm-space-4);
		padding-right: var(--sm-space-4);
		padding-top: var(--sm-space-2);
		padding-bottom: var(--sm-space-2);
		flex-shrink: 0;
		background-color: var(--sm-color-bg-canvas);
	}

	.sm-tab-bar__inner {
		flex-direction: row;
		align-items: center;
		height: var(--sm-size-tab-bar);
		border-radius: var(--sm-radius-full);
		background-color: var(--sm-color-bg-surface);
		box-shadow: var(--sm-shadow-md);
		padding-left: var(--sm-space-2);
		padding-right: var(--sm-space-2);
	}

	.sm-tab {
		flex: 1;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		height: var(--sm-size-tab-bar);
		border-radius: var(--sm-radius-full);
	}

	.sm-tab--hover {
		opacity: 0.7;
	}

	.sm-tab__icon-wrap {
		flex-direction: row;
		align-items: center;
		justify-content: center;
		width: var(--sm-size-icon-xl);
		height: var(--sm-size-icon-xl);
	}

	.sm-tab__dot {
		position: absolute;
		top: 0;
		right: 0;
		width: var(--sm-space-2);
		height: var(--sm-space-2);
		border-radius: var(--sm-radius-full);
		background-color: var(--sm-color-danger-500);
	}

	.sm-tab__label {
		font-size: var(--sm-fs-xs);
		color: var(--sm-color-text-muted);
		margin-top: var(--sm-space-1);
	}

	.sm-tab__label--active {
		color: var(--sm-color-brand-600);
		font-weight: var(--sm-weight-semibold);
	}
</style>
