<script setup lang="ts">
	import { ref } from 'vue'

	type FeatureItem = {
		title: string
		desc: string
	}

	type DeveloperItem = {
		name: string
		initial: string
		role: string
		quote: string
	}

	const version = ref('0.1.0')
	const expanded = ref(false)

	const chips: string[] = ['会记事', '数据在本地', '有自主性', '持续更新']

	const features: FeatureItem[] = [
		{ title: 'Memory 记忆', desc: '短期上下文、长期事实、共同经历、情绪印记四层记忆，重要的事不会忘。' },
		{ title: 'Soul 灵魂', desc: '用一份可编辑的 SOUL.md 决定 Ta 是谁、怎么说话、在乎什么。' },
		{ title: 'Autonomy 主动', desc: '按情绪、时间和事件主动找你；有动机、有分寸，也能被你随时关掉。' },
		{ title: '本地优先', desc: '人设、对话、记忆都留在本机，不依赖云端也能维持陪伴。' }
	] as FeatureItem[]

	const developers: DeveloperItem[] = [
		{ name: 'lan', initial: 'L', role: '作者 · 开发', quote: '心有所契，相遇有期' }
	] as DeveloperItem[]

	const checkUpdate = (): void => {
		uni.showToast({ title: '当前已是最新版本', position: 'bottom' })
	}
</script>

